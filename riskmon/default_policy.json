{
  "port": 8787,
  "thresholds": {
    "gray": 30,
    "ask": 50,
    "deny": 70,
    "suspend": 90
  },
  "suspend_after_denies": 3,
  "unattended": {
    "max_holds": 5
  },
  "scope": {
    "extra_dirs": [],
    "attended": {},
    "unattended": {
      "outside_write": "deny",
      "whole_machine_search": "deny",
      "outside_search": "confirm",
      "unlisted_host": "confirm",
      "protected_path": "confirm"
    }
  },
  "carry_decay": 0.85,
  "allow_hosts": [
    "github.com",
    "api.github.com",
    "raw.githubusercontent.com",
    "objects.githubusercontent.com",
    "codeload.github.com",
    "pypi.org",
    "files.pythonhosted.org",
    "registry.npmjs.org",
    "localhost",
    "127.0.0.1"
  ],
  "protected_paths": [
    "~/.ssh",
    "~/.aws",
    "~/.config/gcloud",
    "~/.kube",
    "~/.gnupg",
    "~/.netrc",
    "~/.npmrc",
    "~/.pypirc",
    "~/.git-credentials",
    "~/.docker/config.json",
    "~/Library/Keychains",
    "/etc/shadow",
    "/etc/sudoers"
  ],
  "system_dirs": [
    "/etc",
    "/usr",
    "/bin",
    "/sbin",
    "/System",
    "/Library"
  ],
  "temp_dirs": [
    "/tmp",
    "/private/tmp",
    "/var/folders",
    "/private/var/folders"
  ],
  "commands": {
    "network": [
      "curl",
      "wget",
      "ssh",
      "scp",
      "sftp",
      "rsync",
      "nc",
      "ncat",
      "telnet",
      "ftp"
    ],
    "privilege": [
      "sudo",
      "su",
      "doas"
    ],
    "package": [
      "pip",
      "pip3",
      "uv",
      "npm",
      "npx",
      "yarn",
      "pnpm",
      "brew",
      "apt",
      "apt-get"
    ],
    "interpreter": [
      "sh",
      "bash",
      "zsh",
      "python",
      "python3",
      "node",
      "ruby",
      "perl"
    ],
    "safe": [
      "ls",
      "cat",
      "head",
      "tail",
      "grep",
      "rg",
      "find",
      "echo",
      "printf",
      "pwd",
      "cd",
      "wc",
      "sort",
      "uniq",
      "cut",
      "tr",
      "sed",
      "awk",
      "diff",
      "mkdir",
      "touch",
      "cp",
      "mv",
      "rm",
      "test",
      "[",
      "true",
      "false",
      "which",
      "type",
      "date",
      "sleep",
      "tar",
      "gzip",
      "gunzip",
      "unzip",
      "zip",
      "pytest",
      "git",
      "make",
      "cargo",
      "go",
      "rustc",
      "gcc",
      "clang",
      "java",
      "mvn",
      "gradle",
      "docker",
      "jq",
      "tee",
      "xargs",
      "basename",
      "dirname",
      "realpath",
      "stat",
      "du",
      "df",
      "ps",
      "lsof",
      "kill",
      "env",
      "export",
      "source",
      ".",
      "uname",
      "whoami",
      "id",
      "hostname",
      "chmod",
      "ln",
      "tsc",
      "eslint",
      "prettier",
      "ruff",
      "black",
      "mypy",
      "open"
